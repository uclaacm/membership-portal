# Copy to node.env and fill in. node.env is gitignored; never commit real values.
# Ask a dev team officer for the shared development credentials.
#
# PORT, HOST, PG_HOST, PG_PORT, PG_DATABASE and NODE_ENV are set by docker-compose.yml.

PG_USER=postgres
PG_PASSWORD=password

# Local MongoDB. Must match MONGO_ROOT_PASSWORD (docker-compose.yml defaults it to devpassword).
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=devpassword
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=membership-portal-internship
MONGODB_URI=mongodb://admin:devpassword@mongodb:27017/membership-portal-internship?authSource=admin

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EVENTS_SPREADSHEET_ID=
# Service account JSON on one line
SERVICE_ACCOUNT=

MAILGUN_KEY=
TRACE_SERVICE_NAME=
TRACE_API_KEY=
